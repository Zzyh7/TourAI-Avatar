# ==================== DeepSeek API ====================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ==================== 阿里百炼 (通义千问-VL 多模态) ====================
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# ==================== 高德地图 API (MCP) ====================
AMAP_API_KEY=your-amap-api-key-here

# ==================== 豆包语音合成 TTS (火山引擎 Seed-TTS-2.0) ====================
DOUBAO_TTS_API_KEY=your-doubao-tts-api-key-here
# DOUBAO_TTS_V1_API_KEY=your-doubao-tts-v1-api-key-here  # V1 HTTP fallback Key（可选）
# DOUBAO_TTS_APPID=default  # 可选，火山引擎应用 ID
# DOUBAO_TTS_VOICE=zh_male_tiancaitongsheng_mars_bigtts  # 默认音色
# DOUBAO_TTS_SPEED_RATIO=1.0  # 语速 0.5~2.0

# ==================== HuggingFace (BGE 嵌入模型) ====================
# HF_HUB_OFFLINE=1  # 设为 1 离线模式（需预先下载 BAAI/bge-small-zh-v1.5）

# ==================== 管理员默认账号 ====================
# ADMIN_DEFAULT_ACCOUNT=id123456
# ADMIN_DEFAULT_PASSWORD=123456
